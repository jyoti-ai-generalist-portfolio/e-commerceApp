FROM node:24-alpine

WORKDIR /app

ENV PNPM_HOME="/pnpm"
ENV PATH="/app/node_modules/.bin:$PNPM_HOME:$PATH"

ENV WATCHPACK_POLLING=true
ENV npm_config_store_dir="/pnpm/store"
ENV npm_config_verify_deps_before_run=false
ENV npm_config_node_linker=hoisted

RUN corepack enable && corepack prepare pnpm@10 --activate

RUN echo "verify-deps-before-run=false" > /etc/npmrc && \
    echo "node-linker=hoisted" >> /etc/npmrc && \
    echo "store-dir=/pnpm/store" >> /etc/npmrc

COPY package.json pnpm-lock.yaml pnpm-workspace.yaml* ./
COPY ecommerce-admin/package.json ./ecommerce-admin/
COPY ecommerce-customer/package.json ./ecommerce-customer/

RUN pnpm install --no-frozen-lockfile

COPY . .

EXPOSE 3000 3001
